{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
    "Properties": {
      "Application": "Clinic.Api"
    }
  },
  "Jwt": {
    "Issuer": "ClinicApi",
    "Audience": "ClinicApiUsers",
    "ExpiryMinutes": 120
  },
  "BootstrapAdmin": {
    "UserName": "admin",
    "Email": "admin@clinic.local"
  }
}
